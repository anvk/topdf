{
  "name": "topdf",
  "version": "0.1.0",
  "description": "An HTTP server that turns HTML, web pages, images, Markdown and text into PDF",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "fastify": "^5.12.7",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
